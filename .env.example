# EJEMPLO DE VARIABLES DE ENTORNO
# Copiar a .env para desarrollo local

# Base de datos (Railway la proporciona automáticamente)
# DATABASE_URL=postgresql://user:password@host:port/database
# Para local, comentar y usará SQLite automáticamente

# Warehouse de Mercadona (opcional, default: mad1)
WAREHOUSE=mad1

# Python (para Railway)
PYTHONUNBUFFERED=1

# Workers (ajustar según recursos)
WEB_CONCURRENCY=3

# Railway environment (detectado automáticamente)
# RAILWAY_ENVIRONMENT=production
